# Only ignore editor-generated junk and build output.
# Do NOT ignore your study files such as .py, .java, .md, .txt, etc.

# VS Code / editor metadata
.vscode/
.vscode/*.json
.vscode/*.code-snippets
.idea/
*.iml

# Build outputs and compiled files
*.class
bin/
out/
target/
__pycache__/
*.pyc
*.pyo

# OS / temp files
.DS_Store
Thumbs.db
*.log
*.tmp
*.swp
*~
